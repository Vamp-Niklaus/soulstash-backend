# Soulstash Go Backend Configuration Example
# Copy this file to .env for local development

# Server Configuration
PORT=3000
NODE_ENV=development
APP_ENV=development

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=soulstash

# Security / Authentication
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars

# Third-Party Integrations
# Brevo (Sendinblue) Transactional Email API Key for OTPs
BREVO_API_KEY=your_brevo_api_key_here

# The Movie Database (TMDB) API
TMDB_BEARER_TOKEN=your_tmdb_bearer_token_here
TMDB_BASE_URL=https://api.tmdb.org

# OMDb API Key for IMDb ratings
OMDB_API_KEY=your_omdb_api_key_here

# Watchmode API Key for fallback player sources
WATCHMODE_API_KEY=your_watchmode_api_key_here

# Scraper & Playwright Options
CF_CLEARANCE=
PLAYWRIGHT_BROWSERS_PATH=default

# Development SPA Proxy
VITE_DEV_SERVER_ORIGIN=http://localhost:5173
